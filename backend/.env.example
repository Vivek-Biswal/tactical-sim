HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

# Enable after providing the backend IAM credential (keep the default for local demos).
STORAGE_BACKEND=memory
FIREBASE_PROJECT_ID=tactical-sim-d3bf4
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_CHECKPOINT_SECONDS=5
# Secret on Render, JSON from a dedicated account with roles/datastore.user.
# Never put this credential in NEXT_PUBLIC_ variables or commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively use Google's Application Default Credentials / secret file:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
