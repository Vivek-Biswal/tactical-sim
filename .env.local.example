# Firebase Web App credentials (required for Google Sign-In).
# Obtain these from Firebase Console → Project Settings → Your apps → Web app.
# These values are intentionally client-visible (Firebase browser SDK design).
# Never place service-account private keys here.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Backend API URLs — optional locally (defaults to localhost:8000).
# Set both when deploying the frontend separately from the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_WS_BASE_URL=""

# Public, URL-restricted Cesium ion token with assets 1 (terrain) and 2 (imagery).
NEXT_PUBLIC_CESIUM_ION_TOKEN=""
